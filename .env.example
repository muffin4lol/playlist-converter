# PostgreSQL; use a pooled connection on Vercel. Never commit real credentials.
DATABASE_URL="postgresql://playlist:playlist@localhost:5432/playlist_converter?schema=public"
# Exact public origin. Use HTTPS in production; OAuth redirect URIs must match.
APP_URL="http://localhost:3000"
# Publicly displayed support/privacy contact; use an address approved for publication.
PUBLIC_SUPPORT_EMAIL=""
# Generate: openssl rand -hex 32. Exactly 64 hexadecimal characters. Keep stable and secret.
TOKEN_ENCRYPTION_KEY=""
# Vercel daily cleanup authorization. Generate a separate random secret; do not expose publicly.
CRON_SECRET=""
# SMTP URL. Local docker compose exposes Mailpit on port 1025 (inbox UI on 8025).
# Resend SMTP: smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
# Temporary Gmail sender and later domain migration: docs/TEMPORARY-EMAIL.md
# Gmail: smtps://YOUR_EMAIL%40gmail.com:APP_PASSWORD_WITHOUT_SPACES@smtp.gmail.com:465
SMTP_URL="smtp://127.0.0.1:1025"
EMAIL_FROM="Playlist Converter <hello@localhost>"
# Spotify app uses Authorization Code + PKCE, no client secret required.
SPOTIFY_CLIENT_ID=""
# Optional server-only secret for public Spotify playlist reads through Client Credentials.
SPOTIFY_CLIENT_SECRET=""
# Google Cloud OAuth Web Application, enable YouTube Data API v3.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Server-only YouTube Data API key, restricted to that API, for public playlist reads without user OAuth.
YOUTUBE_API_KEY=""
# Show Google's test-user restriction while the consent app is unpublished.
GOOGLE_OAUTH_TESTING="true"
# Optional integration test database. Never point at a production database.
TEST_DATABASE_URL=""

# Apple Music: ES256 developer JWT signed with your MusicKit key (signing key stays outside this app).
# This developer JWT is intentionally delivered to authenticated browsers for MusicKit JS.
APPLE_MUSIC_DEVELOPER_TOKEN=""
APPLE_MUSIC_STOREFRONT="us"
# Deezer: approved existing app. Legacy authorization code flow has no PKCE.
DEEZER_APP_ID=""
DEEZER_APP_SECRET=""
# TIDAL v2 OAuth PKCE app; secret only if required by your registered client type.
TIDAL_CLIENT_ID=""
TIDAL_CLIENT_SECRET=""
TIDAL_COUNTRY_CODE="US"
# SoundCloud OAuth 2.1 confidential app credentials.
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""
